# memory-hub settings (reference). Run `node src/cli.ts init` to write .env with random passwords;
# copy lines from here into .env only for the extra options you need.
# Never commit .env. Every value below is a placeholder. All options: README.md, section on settings (.env).

# Database (Postgres in Docker, 127.0.0.1 only)
MEMHUB_PG_PORT=5441
POSTGRES_PASSWORD=change-me
MEMHUB_RW_PASSWORD=change-me
MEMHUB_RO_PASSWORD=change-me

# Embeddings (local Ollama)
# OLLAMA_URL=http://127.0.0.1:11434
# MEMHUB_EMBED_MODEL=bge-m3

# Obsidian: vaults to read (comma-separated) and the vault memory-hub writes to
# MEMHUB_VAULTS=D:/obsidian-vault/example
# MEMHUB_MEMORY_VAULT=D:/obsidian-vault/memory-hub

# Project paths that must never be indexed (comma-separated prefixes)
# MEMHUB_EXCLUDE_PROJECTS=d:/client-x

# Privacy (MEMHUB_ALLOW_BACKEND = one extra API host allowed with MEMHUB_ANTHROPIC_ONLY=1)
# MEMHUB_ALLOW_BACKEND=
# MEMHUB_ANTHROPIC_ONLY=1        # memory only for Claude apps on Anthropic's API
# MEMHUB_PRIVATE_SOURCES=0       # hide Google data from every app, Claude too

# Google (optional, read-only, Claude-only): OAuth client + token dir, extra Timeline exports, GeoNames dumps
# MEMHUB_GOOGLE_DIR=C:/Users/you/.memory-hub/google
# MEMHUB_TIMELINE_FILES=C:/path/to/Timeline.json
# MEMHUB_GEONAMES_DIR=C:/Users/you/ai-archive/ref/geonames

# Dream (Claude CLI): set MEMHUB_CLAUDE_BIN if Claude Code came from the native installer, not npm i -g
# MEMHUB_CLAUDE_BIN=
# MEMHUB_DREAM_MODEL=sonnet

# Public brain: added automatically on first export. Keep it secret.
# MEMHUB_PUBLIC_SALT (written to .env by the first brain export/publish)
# Synapses of kind sem (nightly `sem`): the local Gemma behind llama-server; key only if it runs with --api-key
# MEMHUB_GEMMA_URL=http://127.0.0.1:8080
# MEMHUB_GEMMA_KEY=

